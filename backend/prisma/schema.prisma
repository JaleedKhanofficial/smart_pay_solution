// SmartPay Solutions v2 — data model per SRS v2 §5.
// This schema is the single source of DDL truth (SRS §2.2); all changes ship
// as `prisma migrate` migrations. Objects Prisma cannot express (partial unique
// indexes for soft deletes, FR-CUS-08) are hand-written in the migration SQL
// and flagged with a comment on the field they guard.

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7 requirement).
datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  operator
}

enum UserStatus {
  active
  disabled
}

enum ProductStatus {
  Active
  Inactive
}

enum ProductCondition {
  New
  Used
}

enum ContractStatus {
  active
  completed
  cancelled
}

enum PaymentMethod {
  Cash
  BankTransfer @map("Bank Transfer")
  Cheque
}

/// SRS §5.1
model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @db.VarChar(120)
  /// Unique via partial index `uq_users_email_live` (WHERE deleted_at IS NULL)
  email        String     @db.VarChar(190)
  passwordHash String     @map("password_hash")
  role         Role       @default(operator)
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz

  refreshTokens    RefreshToken[]
  uploadedFiles    File[]
  recordedPayments Payment[]
  auditLogs        AuditLog[]
  ledgerSnapshots  LedgerSnapshot[]
  capitalEntries   CapitalEntry[]
  expenseEntries   ExpenseEntry[]
  scenarios        SummaryScenario[]

  @@map("users")
}

/// SRS §5.2
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// SRS §5.5 — served only through the authenticated file endpoint (FR-CUS-05-v2)
model File {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uuidName     String   @unique @map("uuid_name")
  originalName String   @map("original_name")
  mime         String   @db.VarChar(120)
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path")
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  uploadedBy      User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  customers       Customer[]
  guarantors      Guarantor[]
  ledgerSnapshots LedgerSnapshot[]

  @@map("files")
}

/// SRS §5.3
model Customer {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String    @map("full_name") @db.VarChar(150)
  fatherHusbandName String    @map("father_husband_name") @db.VarChar(150)
  /// Unique via partial index `uq_customers_cnic_live` (WHERE deleted_at IS NULL)
  cnicNumber        String    @map("cnic_number") @db.VarChar(15)
  mobileNumber      String    @map("mobile_number") @db.VarChar(20)
  address           String
  occupation        String    @db.VarChar(120)
  monthlyIncome     Decimal   @map("monthly_income") @db.Decimal(12, 2)
  cnicFileId        String?   @map("cnic_file_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz

  cnicFile   File?       @relation(fields: [cnicFileId], references: [id], onDelete: Restrict)
  guarantors Guarantor[]
  contracts  Contract[]

  @@index([fullName])
  @@index([cnicNumber])
  @@map("customers")
}

/// SRS §5.4 — exactly two per customer (FR-CUS-03-v2), enforced in the service
model Guarantor {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  position     Int
  fullName     String    @map("full_name") @db.VarChar(150)
  fatherName   String    @map("father_name") @db.VarChar(150)
  relationship String    @db.VarChar(60)
  cnicNumber   String    @map("cnic_number") @db.VarChar(15)
  mobileNumber String    @map("mobile_number") @db.VarChar(20)
  address      String
  cnicFileId   String?   @map("cnic_file_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cnicFile File?    @relation(fields: [cnicFileId], references: [id], onDelete: Restrict)

  @@unique([customerId, position])
  @@map("guarantors")
}

/// SRS §5.6 / FR-PRD-07
model ProductCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  products Product[]

  @@map("product_categories")
}

/// SRS §5.6
model Product {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String        @db.VarChar(150)
  categoryId String        @map("category_id") @db.Uuid
  status     ProductStatus @default(Active)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz

  category  ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contracts Contract[]

  @@index([name])
  @@map("products")
}

/// SRS §5.7 — no running-balance column; outstanding is always derived
model Contract {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId         String           @map("customer_id") @db.Uuid
  productId          String           @map("product_id") @db.Uuid
  salePrice          Decimal          @map("sale_price") @db.Decimal(12, 2)
  markupPct          Decimal          @map("markup_pct") @db.Decimal(5, 2)
  markupAmount       Decimal          @map("markup_amount") @db.Decimal(12, 2)
  netAmount          Decimal          @map("net_amount") @db.Decimal(12, 2)
  downPayment        Decimal          @map("down_payment") @db.Decimal(12, 2)
  financedAmount     Decimal          @map("financed_amount") @db.Decimal(12, 2)
  monthlyInstallment Decimal          @map("monthly_installment") @db.Decimal(12, 2)
  planMonths         Int              @map("plan_months")
  productCondition   ProductCondition @map("product_condition")
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime         @map("end_date") @db.Date
  status             ContractStatus   @default(active)
  writeOff           Boolean          @default(false) @map("write_off")
  termsLockedAt      DateTime?        @map("terms_locked_at") @db.Timestamptz
  notes              String?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz

  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product      Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  installments Installment[]
  payments     Payment[]
  snapshots    LedgerSnapshot[]

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@map("contracts")
}

/// SRS §5.8 — the plan, generated per BR-04-v2 / BR-05
model Installment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  seq        Int
  dueDate    DateTime @map("due_date") @db.Date
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@unique([contractId, seq])
  @@index([dueDate])
  @@map("installments")
}

/// SRS §5.9 — the money, single source of truth. deleted_at = voided.
model Payment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId   String        @map("contract_id") @db.Uuid
  amount       Decimal       @db.Decimal(12, 2)
  paymentDate  DateTime      @map("payment_date") @db.Date
  method       PaymentMethod
  note         String?
  recordedById String        @map("recorded_by") @db.Uuid
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  recordedBy User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([paymentDate])
  @@map("payments")
}

/// SRS §5.10 — immutable; replaces v1 recovery_reports
model LedgerSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  snapshotNo  String   @unique @map("snapshot_no") @db.VarChar(40)
  payload     Json
  pdfFileId   String?  @map("pdf_file_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  legacy      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  contract  Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  pdfFile   File?    @relation(fields: [pdfFileId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@map("ledger_snapshots")
}

/// SRS §5.11
model CapitalEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  periodLabel String    @map("period_label") @db.VarChar(20)
  note        String?
  enteredById String    @map("entered_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  enteredBy User @relation(fields: [enteredById], references: [id], onDelete: Restrict)

  @@map("capital_entries")
}

/// SRS §5.11
model ExpenseEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  periodLabel String    @map("period_label") @db.VarChar(20)
  note        String?
  enteredById String    @map("entered_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  enteredBy User @relation(fields: [enteredById], references: [id], onDelete: Restrict)

  @@map("expense_entries")
}

/// SRS §5.12 — max 20 per user, enforced in the service
model SummaryScenario {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(120)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, name])
  @@map("summary_scenarios")
}

/// SRS §5.13
model Setting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

/// SRS §5.14 — append-only (FR-AUD-03)
model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  entity    String   @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  action    String   @db.VarChar(40)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
