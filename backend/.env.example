# Copy to .env and fill in your own values. Never commit real secrets.
PORT=5000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string. The `schema=sps` parameter (SRS §2.2) is read
# by src/database/data-source.ts and passed to TypeORM as its `schema` option.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_pay_solution?schema=sps"

# Auth (SRS §2.2 / FR-AUT-01). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=1d

# First admin, seeded by `npm run seed` (FR-USR-02-v2: min 10 characters)
SEED_ADMIN_EMAIL=admin@smartpay.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator

# CNIC image storage, kept outside the served bundle (FR-CUS-04-v2)
UPLOAD_DIR=./storage/uploads
